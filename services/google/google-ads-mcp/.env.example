# Google Ads API OAuth.
# Escopo OAuth necessario: https://www.googleapis.com/auth/adwords
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Conta Google Ads sem hifens. Exemplo: 1234567890.
GOOGLE_ADS_CUSTOMER_ID=

# Opcional para MCC/conta administradora, sem hifens.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Versao REST da Google Ads API. Atual em 2026-05: v24.
GOOGLE_ADS_API_VERSION=v24

# Porta local do MCP.
PORT=8788

# Opcional: token simples para proteger o MCP quando publicado.
# Use no ChatGPT como header Authorization: Bearer <valor>.
MCP_BEARER_TOKEN=
